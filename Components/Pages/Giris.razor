@page "/giris"
@rendermode InteractiveServer
@using BerberRandevuSistemi.Services
@inject RandevuServisi Servis
@inject NavigationManager NavManager

<div class="container mt-5" style="max-width: 400px;">
    <div class="card p-4 shadow bg-dark text-white rounded-4 border-secondary">
        <h3 class="text-center mb-4 text-warning">🔑 Berber Girişi</h3>

        @if (!string.IsNullOrEmpty(hataMesaji))
        {
            <div class="alert alert-danger py-2">@hataMesaji</div>
        }

        <div class="mb-3">
            <label class="form-label">Kullanıcı Adı</label>
            <input type="text" class="form-control bg-dark text-white border-secondary" @bind="kullaniciAdi" placeholder="Örn: berberahmet" />
        </div>

        <div class="mb-3">
            <label class="form-label">Şifre</label>
            <input type="password" class="form-control bg-dark text-white border-secondary" @bind="sifre" placeholder="Şifreniz" />
        </div>

        <button class="btn btn-warning w-100 fw-bold py-2" @onclick="GirisYap">Giriş Yap</button>

        <div class="text-center mt-3 d-flex justify-content-between align-items-center">
            <a href="/" class="text-decoration-none text-light small">← Müşteri Ekranı</a>
            <!-- İstediğin gibi yazı rengi siyah yapıldı -->
            <a href="/kayit" class="text-decoration-none text-dark fw-bold small bg-warning px-2 py-1 rounded">Kayıt Ol →</a>
        </div>
    </div>
</div>

@code {
    private string kullaniciAdi = "";
    private string sifre = "";
    private string hataMesaji = "";

    private void GirisYap()
    {
        var bulinanBerber = Servis.Berberler.FirstOrDefault(b => b.KullaniciAdi == kullaniciAdi && b.Sifre == sifre);

        if (bulinanBerber != null)
        {
            Servis.AktifBerber = bulinanBerber;
            NavManager.NavigateTo("/yonetici");
        }
        else
        {
            hataMesaji = "Kullanıcı adı veya şifre hatalı!";
        }
    }
}